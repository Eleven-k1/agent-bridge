{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "out/types-node"
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "tests/service-process.test.ts",
    "tests/bridge-connection.test.ts",
    "vitest.config.ts",
    "electron.vite.config.ts"
  ]
}
