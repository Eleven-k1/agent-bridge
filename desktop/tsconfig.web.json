{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "out/types-web"
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "tests/task-store.test.ts", "tests/app.test.tsx", "tests/ipc-error.test.tsx"]
}
